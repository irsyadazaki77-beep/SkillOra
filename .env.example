# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE CONNECTION (PostgreSQL)
SQL_HOST="localhost"
SQL_DB_NAME="skillora"
SQL_USER="postgres"
SQL_PASSWORD="password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="password"

# SECURITY & BILLING
# Set to "true" to disable guest demo mode
DISABLE_GUEST_DEMO="false"
# HMAC-SHA256 secret used to verify payment gateway webhooks on /api/v1/billing/webhook
BILLING_WEBHOOK_SECRET="replace-with-strong-random-secret"
# Comma-separated allowed CORS origins in production (optional; falls back to APP_URL)
CORS_ORIGINS=""
# Optional Gemini model overrides
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_LIVE_MODEL="gemini-3.8-live"


